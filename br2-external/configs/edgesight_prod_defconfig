# EdgeSight Linux - production image (x86_64, QEMU q35 / any UEFI x86-64-v3 box)
# Target CPU: x86-64-v3 (AVX2/FMA/BMI2) - edge mini-PC class (Intel N100, Ultra-U, Ryzen embedded)
BR2_x86_64=y
BR2_x86_x86_64_v3=y

# Toolchain: prebuilt Bootlin glibc toolchain (saves ~40 min, glibc required by ORT/TFLite)
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_64_V3_GLIBC_STABLE=y

# Build policy: reproducible, hash-checked, hardened userland
BR2_CCACHE=y
BR2_REPRODUCIBLE=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
# Buildroot's own CDN mirror first (hash-checked anyway); upstream sites are the fallback
BR2_PRIMARY_SITE="https://sources.buildroot.net"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_EDGESIGHT_PATH)/board/edgesight/patches"
BR2_OPTIMIZE_2=y
BR2_PIC_PIE=y
BR2_SSP_STRONG=y
BR2_RELRO_FULL=y
BR2_FORTIFY_SOURCE_2=y

# System
BR2_TARGET_GENERIC_HOSTNAME="edgesight"
BR2_TARGET_GENERIC_ISSUE="EdgeSight Linux"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_EDGESIGHT_PATH)/board/edgesight/users.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_EDGESIGHT_PATH)/board/edgesight/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_EDGESIGHT_PATH)/board/edgesight/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_EDGESIGHT_PATH)/board/edgesight/post-fakeroot.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_EDGESIGHT_PATH)/board/edgesight/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="prod"

# Kernel: 6.12 LTS, tinyconfig base + per-concern fragments
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.47"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_EDGESIGHT_PATH)/board/edgesight/linux/tinyconfig-6.12.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_EDGESIGHT_PATH)/board/edgesight/linux/base.cfg $(BR2_EXTERNAL_EDGESIGHT_PATH)/board/edgesight/linux/virtio.cfg $(BR2_EXTERNAL_EDGESIGHT_PATH)/board/edgesight/linux/fs.cfg $(BR2_EXTERNAL_EDGESIGHT_PATH)/board/edgesight/linux/net.cfg $(BR2_EXTERNAL_EDGESIGHT_PATH)/board/edgesight/linux/security.cfg $(BR2_EXTERNAL_EDGESIGHT_PATH)/board/edgesight/linux/ml.cfg $(BR2_EXTERNAL_EDGESIGHT_PATH)/board/edgesight/linux/boot.cfg"
# Buildroot owns the kernel compression choice (it rewrites CONFIG_KERNEL_*), so set it here
BR2_LINUX_KERNEL_ZSTD=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# Application stack
BR2_PACKAGE_EDGESIGHTD=y
BR2_PACKAGE_EDGESIGHTD_ORT=y
BR2_PACKAGE_EDGESIGHTD_TFLITE=y
BR2_PACKAGE_ONNXRUNTIME_BIN=y
BR2_PACKAGE_TENSORFLOW_LITE=y
BR2_PACKAGE_EDGESIGHT_MODELS=y
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_JPEG_TURBO=y
BR2_PACKAGE_MOSQUITTO=y
BR2_PACKAGE_MOSQUITTO_BROKER=y
BR2_PACKAGE_LIBSECCOMP=y

# Platform services
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_RAUC=y

# Root filesystem: read-only squashfs (zstd), protected by dm-verity in post-image
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
# BR2_TARGET_ROOTFS_TAR is not set

# Bootloader: GRUB2 EFI with RAUC A/B boot-selection logic
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux fat part_gpt normal loadenv test echo configfile serial terminal reboot halt sleep"
BR2_TARGET_GRUB2_INSTALL_TOOLS=y

# Host tools for image assembly, verity and signed bundles
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_E2FSPROGS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_RAUC=y
BR2_PACKAGE_HOST_CRYPTSETUP=y
