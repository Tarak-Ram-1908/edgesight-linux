#!/bin/sh
# Boot health check -> RAUC slot confirmation.
# GRUB marked this slot "tried" (X_TRY=1) before booting it. Only when the
# inference service answers /healthz (model loaded + self-test inference passed)
# do we confirm the slot. Otherwise mark it bad and reboot: GRUB falls back.
. /etc/edgesight/edgesight.conf
log() { echo "edgesight-health: $*" > /dev/kmsg; echo "edgesight-health: $*" >&2; }
SLOT=$(sed -n 's/.*rauc\.slot=\([AB]\).*/\1/p' /proc/cmdline)
VER=$(cat /etc/edgesight-version)

i=0
while [ "$i" -lt "${HEALTH_TIMEOUT:-45}" ]; do
    if wget -q -T 2 -O /dev/null "http://127.0.0.1:${HTTP_PORT}/healthz" 2>/dev/null; then
        if rauc status mark-good booted >/tmp/rauc-mark.log 2>&1; then
            log "slot $SLOT v$VER healthy, marked good (uptime $(cut -d' ' -f1 /proc/uptime)s)"
        else
            log "slot $SLOT v$VER healthy but RAUC mark-good FAILED: $(tail -n1 /tmp/rauc-mark.log)"
        fi
        if [ -f /data/ota/pending ]; then
            P=$(cat /data/ota/pending)
            if [ "$P" != "$VER" ]; then
                echo "$P" >> /data/ota/rejected
                log "update $P did not survive its first boot - rolled back to $VER, blacklisted"
            else
                log "update $P confirmed"
            fi
            rm -f /data/ota/pending
        fi
        exit 0
    fi
    sleep 1
    i=$((i + 1))
done

log "slot $SLOT v$VER FAILED health check after ${HEALTH_TIMEOUT}s -> mark-bad, reboot to fallback"
rauc status mark-bad booted >/dev/null 2>&1
sync
reboot
