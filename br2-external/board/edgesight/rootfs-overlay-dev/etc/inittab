# EdgeSight inittab - DEV variant: adds a root shell on the serial console and SSH
::sysinit:/etc/init.d/rcS
::respawn:/usr/libexec/edgesight/run-edgesightd
::respawn:/usr/libexec/edgesight/run-mosquitto
::once:/usr/libexec/edgesight/health-check
::respawn:/usr/libexec/edgesight/ota-agent
::respawn:/usr/sbin/dropbear -F -R -B -p 22
ttyS0::respawn:/sbin/getty -L ttyS0 115200 vt100
::shutdown:/etc/init.d/rcK
::restart:/sbin/init
